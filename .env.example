# ============================================================
# Alessandra — Variables de entorno
# Copia este archivo a .env.local y rellena los valores reales
# NUNCA commitear .env.local
# ============================================================

# ---- Supabase -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Bucket de Storage privado — los uploads devuelven signed URLs válidas 1h
STORAGE_BUCKET=citizen-report-media

# Sandbox de solo-lectura para text-to-SQL (opcional)
# Apunta a un usuario Postgres que hereda rol sql_sandbox
# Ver migrations/sql/004_readonly_role.sql para setup
SUPABASE_SANDBOX_DB_URL=postgresql://sandbox_user:<password>@db.<project-ref>.supabase.co:5432/postgres

# ---- Modelos (OpenRouter) — PROVEEDOR PRIMARIO ---------------
# Todo el tráfico de modelos pasa por OpenRouter (OpenAI/Google/Anthropic/Mistral
# via protocolo openai-compatible). Solo necesitas esta llave.
OPENROUTER_API_KEY=sk-or-v1-...

# Base URL de OpenRouter (opcional — default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Headers de analytics recomendados por OpenRouter (opcional)
# HTTP_REFERER=https://alcaldia-cuauhtemoc.local
# APP_TITLE=Alessandra · Alcaldía Cuauhtémoc

# ---- AI Providers directos — OPCIONAL -----------------------
# Solo necesarios si bypaseas OpenRouter para ir directo al proveedor.
# Con OPENROUTER_API_KEY activo, estas llaves NO son necesarias.
# OPENAI_API_KEY=sk-...
# GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# ---- Model overrides (opcional — defaults = slugs OpenRouter) ----
# MODEL_ROUTER=google/gemini-2.5-flash
# MODEL_MAIN=google/gemini-2.5-flash             # tool-calling determinístico, 1M ctx, vision (recomendado)
# MODEL_MAIN_ALT=openai/gpt-4o-mini              # alternativa OpenAI si se necesita
# MODEL_SQL=google/gemini-2.5-pro
# MODEL_EXTRACTION=google/gemini-2.5-flash
# MODEL_VISION=google/gemini-2.5-flash-lite       # soporta imagen; barato y estable
# MODEL_CHAT=google/gemini-2.5-flash
# MODEL_EVAL=google/gemini-2.5-pro
# MODEL_EMBEDDINGS=text-embedding-3-small

# ---- Session / Flow config (opcional — defaults abajo) -----
SESSION_TTL_HOURS=6
FLOW_TTL_MINUTES=30
MAX_CONTEXT_MESSAGES=20

# ---- Node ---------------------------------------------------
NODE_ENV=development

# --- Twilio WhatsApp Sandbox (only needed for /api/whatsapp/webhook) ---
# Get ACCOUNT_SID and AUTH_TOKEN from Twilio Console → Account Info.
# WHATSAPP_FROM defaults to the shared sandbox number; override if using a
# provisioned number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Set this to your tunnel/proxy public base URL so Twilio signature validation
# uses the correct HTTPS URL instead of the internal localhost one (cloudflared, ngrok, etc.).
# TWILIO_WEBHOOK_BASE_URL=https://abc.trycloudflare.com

# ---- ElevenLabs Voice Channel -----------------------------------------------
# Bearer secret for /api/agent/voice-tools/* endpoints.
# ElevenLabs sends this in the Authorization header when calling server tools.
# Generate with: openssl rand -hex 32
ELEVENLABS_TOOLS_BEARER=<random_secret_min_32_chars>

# HMAC secret for /api/agent/elevenlabs-webhook (post-call webhook).
# Set this in the ElevenLabs dashboard → workspace → webhooks → secret.
# Generate with: openssl rand -hex 32
ELEVENLABS_WEBHOOK_SECRET=<random_secret_min_32_chars>

# ElevenLabs API key (Profile → API Keys in dashboard).
ELEVENLABS_API_KEY=<sk_...>

# Agent ID — leave blank on first deploy; the script prints it after POST so you can paste it back here.
ELEVENLABS_AGENT_ID=

# Voice ID (preset from library or cloned). Default below is a placeholder; swap for a Spanish-MX voice.
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9

# Public URL of this Next.js backend (must be HTTPS). cloudflared tunnel works for dev.
PUBLIC_BASE_URL=https://<your-tunnel>.trycloudflare.com
