{
  "functions": {
    "app/api/chat/route.ts": {
      "maxDuration": 60,
      "runtime": "nodejs20.x"
    },
    "app/api/upload/route.ts": {
      "maxDuration": 60,
      "runtime": "nodejs20.x"
    }
  },
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
